{
  "name": "market-intelligence",
  "version": "1.0.0",
  "description": "Yieldr Market Intelligence — TAAPI + CoinGlass data ingestion pipeline",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "fetch-once": "tsx src/scripts/fetch-once.ts",
    "fetch-coin": "tsx src/scripts/fetch-coin.ts",
    "refresh-coins": "tsx src/scripts/refresh-coins.ts",
    "health": "curl -s http://localhost:3000/health | node -e \"const d=require('fs').readFileSync('/dev/stdin','utf8');console.log(JSON.parse(d))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
