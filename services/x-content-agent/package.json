{
  "name": "x-content-agent",
  "version": "1.0.0",
  "description": "X Content Agent for Yieldr - generates and publishes content on X, monitors replies and mentions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
