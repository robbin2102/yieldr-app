    "openai": "^4.50.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "mongodb": "^6.3.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
