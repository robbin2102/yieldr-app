# ═══════════════════════════════════════════════════════════════
# X Content Agent Environment Variables
# ═══════════════════════════════════════════════════════════════

# MongoDB
MONGODB_URI=mongodb+srv://...

# xAI / Grok (for content generation)
XAI_API_KEY=xai-...

# X API v2 (Twitter) - Pay Per Use
# See X-API-SETUP.md for how to get these
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# Telegram Bot (for channel posting)
# Create via @BotFather, add bot as admin to your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@yieldr_alpha

# MCP Server URL (for data fetching)
MCP_SERVER_URL=http://localhost:3001
