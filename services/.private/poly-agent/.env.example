# ===========================================
# POLY-AGENT v1 CONFIGURATION
# ===========================================

# Target Trader Wallet (the wallet we're copying)
TARGET_WALLET=0xcde6e9587582e568041e1aa0ea0b01793e1311d7

# Bot Wallet (YOUR dedicated trading wallet - NEVER use your main wallet)
BOT_WALLET_ADDRESS=
BOT_PRIVATE_KEY=

# Polymarket API Credentials
# Get from: https://polymarket.com/settings/api
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# MongoDB Connection String
# Use existing yieldr database
MONGODB_URI=

# ===========================================
# AGENT PARAMETERS
# ===========================================

# Copy ratio: fraction of trader's size (0.05 = 5%)
COPY_RATIO=0.05

# Maximum position size in USDC (safety limit for testing)
MAX_POSITION_USDC=50

# Minimum trade size in shares (skip trades below this)
MIN_TRADE_SIZE=1

# ===========================================
# POLLING INTERVALS (milliseconds)
# ===========================================

# Detector polling interval
DETECTOR_INTERVAL_MS=3000

# Reconciler position check interval
RECONCILER_INTERVAL_MS=60000

# ===========================================
# POLYMARKET ENDPOINTS (defaults should work)
# ===========================================

DATA_API_BASE=https://data-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com
WSS_MARKET=wss://ws-subscriptions-clob.polymarket.com/ws/market
WSS_USER=wss://ws-subscriptions-clob.polymarket.com/ws/user

# Chain ID (137 = Polygon Mainnet, 80002 = Amoy Testnet)
CHAIN_ID=137
