{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/modules/detector.ts",
    "src/modules/executor.ts",
    "src/modules/initialCopier.ts",
    "src/modules/metrics.ts",
    "src/modules/reconciler.ts",
    "src/modules/executionTracker.ts"
  ]
}
