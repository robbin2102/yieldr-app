FROM node:20-slim

WORKDIR /app

# ── 1. Install ALL deps (including devDeps for tsc) ──────────────
COPY package.json package-lock.json* ./
RUN npm ci

# ── 2. Copy source and compile (root-level scripts + src/) ───────
COPY tsconfig.fly.json ./
COPY src ./src
COPY sell-position.ts redeem-positions.ts ./
RUN npx tsc --project tsconfig.fly.json --noCheck

# ── 3. Prune devDeps (tsx no longer needed at runtime) ───────────
RUN npm prune --omit=dev

# ── 4. Expose health port ─────────────────────────────────────────
EXPOSE 3001

CMD ["node", "dist/src/admin-service.js"]
