    "express": "^4.18.2",
    "idb": "^8.0.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.0.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.19.8",
    "wagmi": "^2.12.5"
  },
