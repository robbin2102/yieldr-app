{
  "name": "yieldr-app",
  "version": "1.0.0",
  "description": "Yieldr Asset Manager Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "backend": "node backend-src/server.js",
    "listener": "tsx services/avantis-listener/server.ts",
    "listener:dev": "nodemon --exec tsx services/avantis-listener/server.ts",
    "polymarket:prod": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx services/polymarket-tracker/index.ts",
    "polymarket:start": "POLYMARKET_WALLETS=0xecd55daa7c6900683b804d1d4db935fbfabe43f4 POLYMARKET_POLL_INTERVAL_MS=60000 POLYMARKET_API_DELAY_MS=300 DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx services/polymarket-tracker/index.ts",
    "polymarket:dev": "POLYMARKET_WALLETS=0xecd55daa7c6900683b804d1d4db935fbfabe43f4 POLYMARKET_POLL_INTERVAL_MS=60000 POLYMARKET_API_DELAY_MS=300 DOTENV_CONFIG_PATH=.env.local nodemon --exec \"node --require dotenv/config node_modules/.bin/tsx services/polymarket-tracker/index.ts\"",
    "polymarket:test": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/test-polymarket-tracker.ts",
    "polymarket:clear-all": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/clear-all-polymarket-data.ts",
    "polymarket:verify": "tsx scripts/verify-polymarket-data.ts",
    "polymarket:verify-all": "tsx scripts/verify-all-data.ts",
    "polymarket:prod-test": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/test-production-flow.ts",
    "polymarket:test-api": "tsx scripts/test-polymarket-api.ts",
    "polymarket:monitor": "tsx scripts/monitor-trader-activity.ts",
    "polymarket:diagnose": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/diagnose-pnl-discrepancy.ts",
    "polymarket:refresh": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/force-refresh-closed-positions.ts",
    "polymarket:fetch-all": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/fetch-and-save-all-positions.ts",
    "polymarket:test-pnl": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/test-api-vs-mongo-pnl.ts",
    "polymarket:check-dupes": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/check-duplicate-keys.ts",
    "polymarket:check-asset-dupes": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/check-asset-duplicates.ts",
    "polymarket:inspect-api": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/inspect-api-fields.ts",
    "polymarket:clear": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/clear-closed-positions.ts",
    "polymarket:clear-open": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/clear-open-positions.ts",
    "polymarket:drop-indexes": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/drop-old-indexes.ts",
    "polymarket:query-mongo": "DOTENV_CONFIG_PATH=.env.local node --require dotenv/config node_modules/.bin/tsx scripts/query-mongo-positions.ts",
    "polymarket:check-api": "npx tsx scripts/check-raw-closed-position-api.ts",
    "polymarket:index-markets": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/index-polymarket-markets.ts --markets-only",
    "polymarket:fetch-holders": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/index-polymarket-markets.ts --holders-only",
    "polymarket:full-index": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/index-polymarket-markets.ts",
    "backfill": "tsx scripts/backfill-all-managers.ts",
    "backfill:wallet": "tsx scripts/backfill-single-wallet.ts",
    "test:client": "tsx services/avantis-listener/test-client.ts",
    "fix:timestamps": "tsx scripts/fix-close-timestamps.ts",
    "fix:durations": "tsx scripts/recalculate-durations.ts",
    "fix:all": "tsx scripts/fix-all-timestamps.ts",
    "fix:open-times": "tsx scripts/fix-executedAt-from-blocks.ts",
    "merge:trades": "tsx scripts/merge-duplicate-trades.ts",
    "clear:trades": "tsx scripts/clear-all-trades.ts",
    "update:pairs": "tsx scripts/update-pairs.ts",
    "diagnose:closes": "tsx scripts/diagnose-missing-closes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@rainbow-me/rainbowkit": "^2.1.3",
    "@tanstack/react-query": "^5.51.23",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "idb": "^8.0.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.0.0",
    "next": "^15.5.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.19.8",
    "wagmi": "^2.12.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "@types/react": "^18.3.26",
    "autoprefixer": "^10.4.17",
    "bufferutil": "^4.0.9",
    "encoding": "^0.1.13",
    "lokijs": "^1.5.12",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "utf-8-validate": "^5.0.10"
  }
}
