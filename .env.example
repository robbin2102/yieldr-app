# ========================================
# FRONTEND (Next.js)
# ========================================

# WalletConnect Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# App URL for mobile wallet deeplinking
# Production: https://your-domain.com
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development server port
PORT=3000

# ========================================
# SHARED (Frontend + Backend)
# ========================================

# MongoDB Connection
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/yieldr

# QuickNode Base RPC endpoint (Token API v2)
QUICKNODE_BASE_RPC_URL=https://your-quicknode-endpoint.quiknode.pro/xxx/

# ========================================
# BACKEND (Yieldr Data Services API)
# ========================================

# API server port (defaults to 8000 if not set)
# Set this to avoid conflict with Next.js frontend on port 3000
API_PORT=8000

# Moralis API key for wallet profitability and top traders
MORALIS_API_KEY=your-moralis-api-key

# API key for authenticating requests to Yieldr Data Services
API_KEY=your-secure-api-key

# ========================================
# OPTIONAL (Part 4 & 6 of Data Services)
# ========================================

# Taapi.io API key for technical indicators (RSI, MACD, etc.)
# TAAPI_API_KEY=your-taapi-key

# QuickNode Stream webhook secret for signature verification
# QUICKNODE_STREAM_SECRET=your-webhook-secret
