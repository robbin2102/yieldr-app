# ========================================
# REQUIRED - Part 1: Core API Setup
# ========================================

# MongoDB connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/yieldr

# QuickNode Base RPC endpoint (Token API v2)
QUICKNODE_BASE_RPC_URL=https://your-quicknode-endpoint.quiknode.pro/xxx/

# Moralis API key for wallet profitability and top traders
MORALIS_API_KEY=your-moralis-api-key

# API key for authenticating requests to this service
API_KEY=your-api-key-for-auth

# ========================================
# OPTIONAL - Part 4: Technical Indicators
# ========================================

# Taapi.io API key for technical indicators (RSI, MACD, etc.)
# TAAPI_API_KEY=your-taapi-key

# ========================================
# OPTIONAL - Part 6: Real-time Webhooks
# ========================================

# QuickNode Stream webhook secret for signature verification
# QUICKNODE_STREAM_SECRET=your-webhook-secret
